<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head th:fragment="head">
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title th:text="${content.title != null} ? ${content.title} : 'Sven Bauhan'">Sven Bauhan</title>
  <link rel="stylesheet" th:href="${(content.rootpath != null ? content.rootpath : '') + 'css/asciidoctor.css'}"/>
  <link rel="stylesheet" th:href="${(content.rootpath != null ? content.rootpath : '') + 'css/base.css'}"/>
  <link rel="icon" th:href="${(content.rootpath != null ? content.rootpath : '') + 'favicon.ico'}"/>
</head>
</html>
